.study-detail-page{-webkit-animation:fadeIn .5s ease both;animation:fadeIn .5s ease both;background:-webkit-gradient(linear,left top,left bottom,from(#efe9dc),to(#fff));background:-webkit-linear-gradient(top,#efe9dc,#fff);background:linear-gradient(180deg,#efe9dc,#fff);min-height:100vh;padding-bottom:40rpx}.study-detail-page .nav-bar{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;background:-webkit-linear-gradient(292deg,#234a2c,#2f5d3a 42%,#4a7c59);background:linear-gradient(158deg,#234a2c,#2f5d3a 42%,#4a7c59);justify-content:space-between;padding:30rpx}.study-detail-page .nav-bar .back-btn{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;height:60rpx;width:60rpx;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;color:#fff;font-size:48rpx;font-weight:700;justify-content:center}.study-detail-page .nav-bar .back-btn:active{opacity:.7}.study-detail-page .nav-bar .page-title{color:#fff;font-size:32rpx;font-weight:700}.study-detail-page .nav-bar .progress-display{color:#fff;font-size:24rpx;text-align:center;width:60rpx}.study-detail-page .overall-progress{background:#fff;border-radius:16rpx;margin:20rpx 30rpx;padding:30rpx}.study-detail-page .overall-progress .progress-bar-bg{background:#f2ede2;border-radius:8rpx;height:16rpx;margin-bottom:12rpx;overflow:hidden;width:100%}.study-detail-page .overall-progress .progress-bar-bg .progress-bar-fill{background:-webkit-gradient(linear,left top,right top,from(#4a7c59),to(#6fae73));background:-webkit-linear-gradient(left,#4a7c59,#6fae73);background:linear-gradient(90deg,#4a7c59,#6fae73);border-radius:8rpx;height:100%;-webkit-transition:width .3s;transition:width .3s}.study-detail-page .overall-progress .progress-text{color:#66716a;font-size:24rpx;text-align:right}.study-detail-page .overall-progress .reset-btn{margin-top:16rpx;text-align:right}.study-detail-page .overall-progress .reset-btn .reset-btn-text{background:#e5dec9;border:1rpx solid #ded5bd;border-radius:999rpx;color:#e54545;display:inline-block;font-size:24rpx;padding:8rpx 20rpx}.study-detail-page .npc-guide{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;background:#fff;border-radius:16rpx;margin:0 30rpx 20rpx;padding:30rpx}.study-detail-page .npc-guide .npc-avatar{border:4rpx solid #4a7c59;border-radius:50%;height:100rpx;margin-right:20rpx;width:100rpx}.study-detail-page .npc-guide .npc-content{-webkit-flex:1;-ms-flex:1;flex:1}.study-detail-page .npc-guide .npc-content .npc-name{color:#1f2a24;display:block;font-size:28rpx;font-weight:700;margin-bottom:12rpx}.study-detail-page .npc-guide .npc-content .guide-bubble{background:#efe9dc;border-radius:16rpx;color:#4a564e;display:inline-block;font-size:26rpx;padding:16rpx 24rpx;position:relative}.study-detail-page .npc-guide .npc-content .guide-bubble::before{border-bottom:12rpx solid transparent;border-right:12rpx solid #efe9dc;border-top:12rpx solid transparent;content:"";height:0;left:-12rpx;position:absolute;top:50%;-webkit-transform:translateY(-50%);-ms-transform:translateY(-50%);transform:translateY(-50%);width:0}.study-detail-page .level-list{padding:0 30rpx}.study-detail-page .level-item{background:#fff;border-radius:16rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;margin-bottom:20rpx;padding:30rpx;position:relative;-webkit-transition:all .3s;transition:all .3s}.study-detail-page .level-item:active{-webkit-transform:scale(.98);-ms-transform:scale(.98);transform:scale(.98)}.study-detail-page .level-item.locked{opacity:.6}.study-detail-page .level-item.completed{border:2rpx solid #2ba471}.study-detail-page .level-item.in_progress{border:2rpx solid #e37318}.study-detail-page .level-item .level-badge{-webkit-align-items:center;background:-webkit-linear-gradient(292deg,#234a2c,#2f5d3a 42%,#4a7c59);background:linear-gradient(158deg,#234a2c,#2f5d3a 42%,#4a7c59);border-radius:50%;color:#fff;display:-webkit-flex;display:-ms-flexbox;display:flex;height:60rpx;width:60rpx;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;-webkit-flex-shrink:0;font-size:28rpx;font-weight:700;justify-content:center;-ms-flex-negative:0;flex-shrink:0;z-index:2}.study-detail-page .level-item .level-badge.completed{background:-webkit-linear-gradient(315deg,#b98e4e,#d9bd8a);background:linear-gradient(135deg,#b98e4e,#d9bd8a)}.study-detail-page .level-item .level-line{background:#e7e0d2;height:60rpx;left:59rpx;position:absolute;top:120rpx;width:4rpx;z-index:1}.study-detail-page .level-item .level-line.completed{background:#2ba471}.study-detail-page .level-item .level-content{-webkit-flex:1;-ms-flex:1;flex:1;margin-left:20rpx}.study-detail-page .level-item .level-content .level-header{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;-webkit-align-items:center;justify-content:space-between;-ms-flex-align:center;align-items:center;margin-bottom:12rpx}.study-detail-page .level-item .level-content .level-header .level-name-wrap{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-webkit-flex:1;-ms-flex:1;flex:1;gap:12rpx;min-width:0}.study-detail-page .level-item .level-content .level-header .level-thumb{-webkit-flex-shrink:0;-ms-flex-negative:0;border-radius:8rpx;flex-shrink:0;height:54rpx;width:72rpx}.study-detail-page .level-item .level-content .level-header .level-name{color:#1f2a24;font-size:30rpx;font-weight:700}.study-detail-page .level-item .level-content .level-header .type-tag{border-radius:12rpx;font-size:22rpx;padding:6rpx 16rpx}.study-detail-page .level-item .level-content .level-desc{color:#4a564e;display:block;font-size:26rpx;line-height:1.6;margin-bottom:12rpx}.study-detail-page .level-item .level-content .level-footer{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;-ms-flex-pack:justify;-webkit-align-items:center;justify-content:space-between;-ms-flex-align:center;align-items:center}.study-detail-page .level-item .level-content .level-footer .completion-condition{color:#66716a;font-size:24rpx}.study-detail-page .level-item .level-content .level-footer .in-progress-tag{color:#e37318;font-size:22rpx;font-weight:500}.study-detail-page .level-item .level-content .level-footer .skipped-tag{color:#66716a;font-size:22rpx}.loading{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;color:#66716a;font-size:28rpx;height:100vh;justify-content:center}